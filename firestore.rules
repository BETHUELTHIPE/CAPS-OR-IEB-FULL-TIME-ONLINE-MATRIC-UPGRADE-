rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public/User accessible collections for student learning portal
    match /profiles/{profileId} {
      allow read, write: if true;
    }
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
    match /payments/{paymentId} {
      allow read, write: if true;
    }
    match /homework_assignments/{assignmentId} {
      allow read, write: if true;
    }
    match /homework_submissions/{submissionId} {
      allow read, write: if true;
    }
    match /video_requests/{requestId} {
      allow read, write: if true;
    }
    match /testimonials/{testimonialId} {
      allow read, write: if true;
    }
    match /announcements/{announcementId} {
      allow read, write: if true;
    }
    match /contact_messages/{messageId} {
      allow read, write: if true;
    }
    match /deep_focus_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /arcade_scores/{scoreId} {
      allow read, write: if true;
    }
    match /arcade_achievements/{achievementId} {
      allow read, write: if true;
    }
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    match /subjects/{subjectId} {
      allow read, write: if true;
    }
    match /packages/{packageId} {
      allow read, write: if true;
    }
    match /faqs/{faqId} {
      allow read, write: if true;
    }
    match /resources/{resourceId} {
      allow read, write: if true;
    }
    match /subscriptions/{subscriptionId} {
      allow read, write: if true;
    }
    match /tutor_availability/{slotId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

